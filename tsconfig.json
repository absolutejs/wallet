{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "changelog/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
